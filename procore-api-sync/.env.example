# Use either a short-lived access token for a quick probe:
PROCORE_ACCESS_TOKEN=

# Or use OAuth Client Credentials from an approved Procore app/service account:
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# Required for project and observation probes once a company is known:
PROCORE_COMPANY_ID=

# Defaults usually work for production Procore:
PROCORE_API_BASE_URL=https://api.procore.com
PROCORE_LOGIN_BASE_URL=https://login.procore.com
